{
  "name": "chess-desktop",
  "version": "1.0.0",
  "description": "A basic Electron desktop app for Chess",
  "main": "main.js",
  "scripts": {
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && ELECTRON_RUN_AS_NODE= electron .\""
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true
  }
}
